; Engine configuration file.
; Godot 4.5.2-stable — ShowdownBot Studio Viewer v0 (Plan B)

config_version=5

[application]

config/name="ShowdownBot Studio"
config/description="Viewer v0 local bundle shell (Plan B)"
config/features=PackedStringArray("4.5")
config/icon="res://icon.svg"
run/main_scene="res://src/workspace/studio_root.tscn"

[display]

; Default window, not the target screen. It must stay SMALLER than a common
; screen or the title bar lands off-screen and the window cannot be dragged --
; which is exactly what 1920x1080 did on a 1920x1080 monitor (owner-reported).
; 1600x900 fits a 1080p screen with room for title bar and taskbar, and is well
; above the 1280x720 floor WorkspaceLayout enforces. Users can maximise.
window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[gdunit4]

settings/common/update_notification_enabled=false

[rendering]

renderer/rendering_method="gl_compatibility"
